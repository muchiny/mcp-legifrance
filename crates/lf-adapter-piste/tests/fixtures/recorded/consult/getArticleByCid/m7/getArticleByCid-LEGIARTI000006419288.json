":[],"articleVersions":[{"id":"LEGIARTI000050396803","etat":"MODIFIE","version":"1.0","dateDebut":-2540678400000,"dateFin":-1337558400000,"numero":null,"ordre":null},{"id":"LEGIARTI000050396821","etat":"ABROGE","version":"2.0","dateDebut":-1337558400000,"dateFin":17193600000,"numero":null,"ordre":null},{"id":"LEGIARTI000006419288","etat":"VIGUEUR","version":"3.0","dateDebut":17193600000,"dateFin":32472144000000,"numero":null,"ordre":null}],"computedNums":["9"],"versionPrecedente":"LEGIARTI000050396821","conditionDiffere":null,"historique":null,"surtitre":null,"renvoi":null,"infosComplementaires":null,"infosComplementairesHtml":null,"infosRestructurationBranche":null,"infosRestructurationBrancheHtml":null,"isMultipleVersions":true,"comporteLiensSP":false},{"id":"LEGIARTI000050396821","idTexte":null,"type":"AUTONOME","texte":"Art. 9. — Tout individu né en France d’un étranger et qui n’y est pas domicilié à l’époque de sa majorité pourra, jusqu’à l’àge de vingt-deux ans accomplis, faire sa soumission de fixer en France son domicile, et, s’il l’y établit dans l’année à compter de l'acte de soumission, réclamer la qualité de Français par une déclaration qui sera enregistrée au ministère de la justice. S’il est âgé de moins de vingt et un ans accomplis, la déclaration sera faite en son nom par son père ; en cas de décès, par sa mère; en cas de décès du père et de la mère ou de leur exclusion de la tutelle, ou dans les cas prévus par les articles 141,142 et 143 du code civil, par le tuteur autorisé par délibération du conseil de famille. Il devient également Français si, ayant été porté sur le tableau de recensement, il prend part aux opérations de recrutement sans opposer son extranéité.","texteHtml":"<p>Art. 9. — Tout individu né en France d’un étranger et qui n’y est pas domicilié à l’époque de sa majorité pourra, jusqu’à l’àge de vingt-deux ans accomplis, faire sa soumission de fixer en France son domicile, et, s’il l’y établit dans l’année à compter de l'acte de soumission, réclamer la qualité de Français par une déclaration qui sera enregistrée au ministère de la justice.</p><p> S’il est âgé de moins de vingt et un ans accomplis, la déclaration sera faite en son nom par son père ; en cas de décès, par sa mère; en cas de décès du père et de la mère ou de leur exclusion de la tutelle, ou dans les cas prévus par les articles 141,142 et 143 du code civil, par le tuteur autorisé par délibération du conseil de famille.</p><p> Il devient également Français si, ayant été porté sur le tableau de recensement, il prend part aux opérations de recrutement sans opposer son extranéité.</p>","num":"9","origine":"LEGI","nature":"Article","versionArticle":"2.0","etat":"ABROGE","dateDebut":-1337558400000,"dateFin":17193600000,"dateDebutExtension":32472144000000,"dateFinExtension":32472144000000,"inap":null,"ordre":128847,"context":{"titresTM":[{"debut":"1804-03-21","fin":"2999-01-01","titre":"Livre Ier : Des personnes","xPath":"/ARTICLE/CONTEXTE/TEXTE/TM/TITRE_TM","cid":"LEGISCTA000006089697","id":"LEGISCTA000006089697","etat":"VIGUEUR"},{"debut":"1994-07-30","fin":"2999-01-01","titre":"Titre Ier : Des droits civils","xPath":"/ARTICLE/CONTEXTE/TEXTE/TM/TM/TITRE_TM","cid":"LEGISCTA000006117610","id":"LEGISCTA000006117610","etat":"VIGUEUR"}],"nombreVersionParent":1,"longeurChemin":38,"titreTxt":[{"debut":"1804-03-21","fin":"2999-01-01","titre":"Code civil","xPath":"/ARTICLE/CONTEXTE/TEXTE/TITRE_TXT","cid":"LEGITEXT000006070721","id":"LEGITEXT000006070721","etat":"VIGUEUR"}]},"cid":"LEGIARTI000006419288","cidTexte":null,"sectionParentCid":"LEGISCTA000006117610","sectionParentId":"LEGISCTA000006117610","sectionParentTitre":"Titre Ier : Des droits civils","fullSectionsTitre":"Livre Ier : Des personnes","refInjection":"IG-20261020","idTechInjection":"LEGIARTI000050396821","idEli":null,"idEliAlias":null,"calipsos":[],"textTitles":[{"id":"LEGITEXT000006070721","titre":"Code civil","titreLong":"Code civil","etat":"VIGUEUR","dateDebut":-5231606400000,"date