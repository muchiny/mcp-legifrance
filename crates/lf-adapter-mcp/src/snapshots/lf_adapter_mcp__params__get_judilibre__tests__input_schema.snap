---
source: crates/lf-adapter-mcp/src/params/get_judilibre.rs
expression: schema()
---
{
  "additionalProperties": false,
  "properties": {
    "detail": {
      "description": "\"summary\" (default): metadata and a short summary. \"full\": the text from offset, up to max_chars.",
      "enum": [
        "summary",
        "full"
      ],
      "type": "string"
    },
    "focus": {
      "description": "A few words: return the best matching passages instead of the summary or window.",
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "description": "A Judilibre decision id: 24 hexadecimal characters (from fr_search_judilibre).",
      "type": "string"
    },
    "max_chars": {
      "default": 4000,
      "description": "Maximum characters of text returned (500 to 40000).",
      "maximum": 40000,
      "minimum": 500,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Start position in characters for detail=\"full\"; pass the next_offset of the previous call.",
      "minimum": 0,
      "type": "integer"
    },
    "part": {
      "description": "Read only this part of the decision. Default: the whole decision.",
      "enum": [
        "introduction",
        "expose",
        "moyens",
        "motivations",
        "dispositif",
        "annexes"
      ],
      "type": "string"
    },
    "passages": {
      "default": 3,
      "description": "Number of passages returned with focus.",
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id"
  ],
  "type": "object"
}
