expression: "sandbox_view(Surface::V01)"
---
{
  "as_of_note": "Data is queried live against the source, so there is no local snapshot date. Any date on a record states when the source published it - not that this connector verified the text is still in force today.",
  "attribution": "Source : Légifrance / DILA — Licence Ouverte 2.0",
  "configuration": {
    "audit_mode": "strict",
    "credentials_configured": true
  },
  "consulted_on": "2026-10-15",
  "eli_note": "The API returns no native ELI for legislation: source_url is the stable Légifrance URL, not an ELI. An eli field appears only when the API provides one; never build an /eli/ path.",
  "environment": "sandbox",
  "families": [
    {
      "fond": "LODA",
      "label": "Laws, ordinances and decrees (consolidated)",
      "tools": [
        "fr_get_act",
