---
source: crates/lf-adapter-mcp/src/params/get_decision.rs
expression: schema()
---
{
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "description": "A JURITEXT..., CONSTEXT... or CETATEXT... id (from fr_search on JURI, CONSTIT or CETAT).",
      "type": "string"
    },
    "detail": {
      "description": "\"summary\" (default): metadata and a short summary. \"full\": the text from offset, up to max_chars.",
      "enum": [
        "summary",
        "full"
      ],
      "type": "string"
    },
    "focus": {
      "description": "A few words: return the best matching passages instead of the summary or window.",
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "max_chars": {
      "default": 4000,
      "description": "Maximum characters of text returned (500 to 40000).",
      "maximum": 40000,
      "minimum": 500,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Start position in characters for detail=\"full\"; pass the next_offset of the previous call.",
      "minimum": 0,
      "type": "integer"
    },
    "passages": {
      "default": 3,
      "description": "Number of passages returned with focus.",
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "decision_id"
  ],
  "type": "object"
}
