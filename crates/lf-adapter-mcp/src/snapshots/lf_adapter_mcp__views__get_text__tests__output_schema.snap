---
source: crates/lf-adapter-mcp/src/views/get_text.rs
expression: schema
---
{
  "properties": {
    "article_id": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "code_title": {
      "type": "string"
    },
    "date_debut": {
      "description": "Omitted when the entry into force is not set yet (see etat).",
      "type": "string"
    },
    "date_fin": {
      "description": "Omitted when the article is in force without an end date.",
      "type": "string"
    },
    "eli": {
      "type": "string"
    },
    "etat": {
      "description": "In force: VIGUEUR, VIGUEUR_ETEN, VIGUEUR_NON_ETEN, ABROGE_DIFF. Not yet in force: VIGUEUR_DIFF (deferred entry, date_debut may be absent). No longer in force: MODIFIE, ABROGE, PERIME, ANNULE, REMPLACE, TRANSFERE, SUBSTITUE, DISJOINT, MODIFIE_MORT_NE. DENONCE: denounced, may still apply during notice and survival (Labour Code, article L2261-10). INITIALE, SANS_ETAT: no signal.",
      "type": "string"
    },
    "next_offset": {
      "description": "Pass as offset to read the next window.",
      "minimum": 0,
      "type": "integer"
    },
    "nota": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "num": {
      "type": "string"
    },
    "parent_id": {
      "description": "LEGITEXT or KALITEXT of the parent text.",
      "type": "string"
    },
    "passages": {
      "items": {
        "properties": {
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "score": {
            "description": "BM25 relevance, only comparable between the passages of this answer.",
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "offset",
          "text",
          "score"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "path": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "summary_source": {
      "enum": [
        "official",
        "dispositif",
        "lead"
      ],
      "type": "string"
    },
    "summary_truncated": {
      "description": "True when the summary itself is cut short or is only the opening of the text. Absent for an official summary or operative part that is given whole (it may still cover only part of the text).",
      "type": "boolean"
    },
    "text": {
      "type": "string"
    },
    "text_length": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "article_id",
    "citation",
    "source_url",
    "text_length"
  ],
  "type": "object"
}
