          },
          "type": "array"
        },
        "citation": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "etat": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "idcc": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "nature": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "citation",
        "source_url"
      ],
      "type": "object"
    }
  },
  "properties": {
    "groups": {
      "items": {
        "$ref": "#/$defs/GroupView"
      },
      "type": "array"
    },
    "note": {
      "type": "string"
    }
  },
