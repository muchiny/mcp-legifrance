---
source: crates/lf-adapter-mcp/src/views/get_bofip.rs
expression: schema
---
{
  "properties": {
    "attribution": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "cited_articles": {
      "description": "Code articles cited by the whole text, at most 50: check them with fr_verify_citations.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cited_articles_truncated": {
      "description": "true when cited_articles is incomplete.",
      "type": "boolean"
    },
    "division": {
      "type": "string"
    },
    "doctrine_note": {
      "description": "What BOFiP is, and the limit of this source.",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "doctrine",
        "news"
      ],
      "type": "string"
    },
    "next_offset": {
      "description": "Pass as offset to read the next window.",
      "minimum": 0,
      "type": "integer"
    },
    "note": {
      "type": "string"
    },
    "passages": {
      "items": {
        "properties": {
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "score": {
            "description": "BM25 relevance, only comparable between the passages of this answer.",
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "offset",
          "text",
          "score"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "publication_id": {
      "description": "Number of the publication on the BOFiP site.",
      "minimum": 0,
      "type": "integer"
    },
    "publications": {
      "description": "Present when the id designates several publications: call again with one publication_id.",
      "items": {
        "properties": {
          "publication_id": {
            "minimum": 0,
            "type": "integer"
          },
          "source_url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "valid_from": {
            "type": "string"
          }
        },
        "required": [
          "publication_id",
          "title"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "serie": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "summary_source": {
      "enum": [
        "official",
        "dispositif",
        "lead"
      ],
      "type": "string"
    },
    "summary_truncated": {
      "description": "True when the summary itself is cut short or is only the opening of the text. Absent for an official summary or operative part that is given whole (it may still cover only part of the text).",
      "type": "boolean"
    },
    "text": {
      "type": "string"
    },
    "text_length": {
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "valid_from": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "attribution",
    "doctrine_note"
  ],
  "type": "object"
}
