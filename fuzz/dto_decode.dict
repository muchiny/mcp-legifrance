# Dictionnaire libFuzzer de la cible dto_decode (format : une entrée par ligne, `nom="valeur"`).
#
# Usage : `cargo +nightly fuzz run dto_decode ... -- -dict=fuzz/dto_decode.dict`, voir
# .github/workflows/weekly.yml. Les entrées sont des jetons que libFuzzer insère ou substitue dans
# les entrées : elles l'amènent vite aux champs déclarés des DTO et aux lecteurs tolérants.

# Marqueur de l'oracle (fuzz/fuzz_targets/dto_decode.rs, MARKER) : une valeur du corps qui le porte
# ne doit jamais ressortir dans la catégorie d'un détail.
marker="sekret"
marker_quoted="\"sekret\""

# Noms JSON des champs déclarés par les DTO de l'adapter (search, consult_text, article, juri,
# acco), entre guillemets : 74 noms, camelCase, avec le renommage `titresTM`.
field_results="\"results\""
field_totalResultNumber="\"totalResultNumber\""
field_totalArticleResultNumber="\"totalArticleResultNumber\""
field_typePagination="\"typePagination\""
field_titles="\"titles\""
field_text="\"text\""
field_nature="\"nature\""
field_origin="\"origin\""
field_etat="\"etat\""
field_date="\"date\""
field_datePublication="\"datePublication\""
